---
import Navbar from '../components/navbar.astro';
import '../styles/global.css';
---

<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/Hesed-Core-logo.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Hesed Core | Ingeniería de Software con Propósito</title>
        <meta name="description" content="Hesed Core diseña y construye plataformas y productos digitales preparados para evolucionar, crecer y proteger la información que sus clientes confían." />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body { font-family: 'Inter', sans-serif; }
            .hero-gradient {
                background: linear-gradient(135deg, 
                    rgba(16, 185, 129, 0.08) 0%, 
                    rgba(59, 130, 246, 0.08) 50%, 
                    rgba(245, 158, 11, 0.04) 100%);
            }
            .floating-shapes {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                overflow: hidden;
                z-index: 0;
            }
            .product-card {
                min-height: 430px;
            }
            .platform-visual {
                background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(248,250,252,1) 100%);
            }
            .core-cloud {
                position: relative;
                isolation: isolate;
                animation: coreFloat 4.8s ease-in-out infinite;
            }
            .core-cloud::before {
                content: '';
                position: absolute;
                z-index: -1;
                left: 7%;
                right: 7%;
                bottom: 6%;
                height: 25%;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.96);
                box-shadow:
                    -58px 8px 0 -8px rgba(255, 255, 255, 0.96),
                    -25px -13px 0 -2px rgba(255, 255, 255, 0.96),
                    25px -18px 0 3px rgba(255, 255, 255, 0.96),
                    61px 6px 0 -6px rgba(255, 255, 255, 0.96),
                    0 16px 22px rgba(59, 130, 246, 0.14);
            }
            .core-cloud::after {
                content: '';
                position: absolute;
                z-index: -2;
                left: 14%;
                right: 14%;
                bottom: 3%;
                height: 12%;
                border-radius: 50%;
                background: rgba(59, 130, 246, 0.16);
                filter: blur(12px);
                transform: scaleX(0.9);
                animation: cloudShadow 4.8s ease-in-out infinite;
            }
            @keyframes coreFloat {
                0%, 100% { transform: translateY(0) rotate(-1deg); }
                50% { transform: translateY(-14px) rotate(1deg); }
            }
            @keyframes cloudShadow {
                0%, 100% { opacity: 0.7; transform: scaleX(0.9); }
                50% { opacity: 0.4; transform: scaleX(0.72); }
            }
            @media (prefers-reduced-motion: reduce) {
                .core-cloud,
                .core-cloud::after {
                    animation: none;
                }
            }
            .shape {
                position: absolute;
                border-radius: 50%;
                background: linear-gradient(45deg, rgba(16, 185, 129, 0.08), rgba(59, 130, 246, 0.08));
                animation: float 6s ease-in-out infinite;
            }
            .shape:nth-child(1) {
                width: 80px;
                height: 80px;
                top: 10%;
                left: 10%;
                animation-delay: 0s;
            }
            .shape:nth-child(2) {
                width: 60px;
                height: 60px;
                top: 20%;
                right: 15%;
                animation-delay: 2s;
            }
            .shape:nth-child(3) {
                width: 100px;
                height: 100px;
                bottom: 20%;
                left: 20%;
                animation-delay: 4s;
            }
            @keyframes float {
                0%, 100% { transform: translateY(0px) rotate(0deg); }
                50% { transform: translateY(-20px) rotate(180deg); }
            }
        </style>
    </head>
    <body class="bg-white text-gray-900 hero-gradient min-h-screen">
        <Navbar />

        <!-- HERO SECTION - "Ingeniería de Software con Propósito" -->
        <section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
            <div class="floating-shapes">
                <div class="shape"></div>
                <div class="shape"></div>
                <div class="shape"></div>
            </div>
            
            <div class="max-w-6xl mx-auto w-full text-center relative z-10">
                <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight mb-8 leading-tight">
                    Ingeniería de Software
                    <br class="hidden sm:block"><span class="text-transparent bg-clip-text bg-gradient-to-r from-green-600 via-blue-600 to-green-600">con Propósito</span>
                </h1>
                
                <p class="text-lg sm:text-xl md:text-2xl text-gray-700 max-w-4xl mx-auto mb-12 leading-relaxed px-4">
                    Hesed Core diseña y construye plataformas y productos digitales preparados para 
                    <strong class="text-gray-900">evolucionar, crecer y proteger</strong> la información que tus clientes confían.
                </p>
                
                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-4 sm:gap-6 mt-12">
                    <a href="#platform" class="group bg-gradient-to-r from-green-600 to-green-700 text-white px-8 py-4 rounded-2xl font-bold text-lg shadow-lg hover:shadow-green-600/40 hover-lift transition-all duration-300">
                        <span class="flex items-center justify-center gap-2">
                            Conocer Hesed Core Platform
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                            </svg>
                        </span>
                    </a>
                    
                    <a href="#productos" class="group bg-white border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-2xl font-bold text-lg hover:border-blue-500 hover:text-blue-600 transition-all duration-300 hover-lift">
                        <span class="flex items-center justify-center gap-2">
                            Explorar Productos
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        </section>

        <!-- AGENDA DE CORE: visible solo bajo demanda -->
        <dialog id="agenda" class="m-auto w-[calc(100%-2rem)] max-w-6xl rounded-3xl bg-slate-50 p-0 text-gray-900 shadow-2xl backdrop:bg-slate-950/70">
            <div class="max-h-[90vh] overflow-y-auto px-5 py-7 sm:px-8 lg:px-10 lg:py-9">
                <div class="mb-8 flex items-start justify-between gap-5">
                    <div class="max-w-3xl">
                        <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-blue-700">Agenda de Core · Septiembre a noviembre 2026</p>
                        <h2 class="mb-4 text-3xl font-black leading-tight sm:text-4xl">Fechas para aprender y compartir</h2>
                        <p class="text-lg leading-relaxed text-gray-700">Seleccionamos las fechas públicas que pueden aportar algo a nuestra comunidad. Lo próximo aparece primero.</p>
                    </div>
                    <button id="agenda-close" type="button" class="rounded-xl border border-gray-300 bg-white p-3 text-gray-600 transition hover:border-gray-500 hover:text-gray-900" aria-label="Cerrar agenda">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </div>
                <div class="mb-5 text-sm font-semibold text-gray-600" aria-live="polite"><span id="agenda-status">Página 1 de 2</span></div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <article data-agenda-page="1" class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm"><div class="mb-5 flex items-start justify-between gap-4"><span class="rounded-full bg-blue-50 px-3 py-1 text-sm font-bold text-blue-700">13 SEP</span><svg class="h-7 w-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M16 3v4M8 3v4m-5 4h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"/></svg></div><p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Tecnología</p><h3 class="mb-2 text-2xl font-bold">Día del Programador</h3><p class="text-gray-700">Reconocemos a quienes convierten problemas en soluciones y construyen tecnología con propósito.</p></article>
                    <article data-agenda-page="1" class="rounded-2xl border border-green-200 bg-white p-6 shadow-sm"><div class="mb-5 flex items-start justify-between gap-4"><span class="rounded-full bg-green-50 px-3 py-1 text-sm font-bold text-green-700">15–16 SEP</span><svg class="h-7 w-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 3v18M3 8h18M3 16h18M5 5l14 14M19 5L5 19"/></svg></div><p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Identidad de México</p><h3 class="mb-2 text-2xl font-bold">Mes patrio e Independencia</h3><p class="text-gray-700">Orgullo por construir tecnología desde México, con respeto, pluralidad y comunidad.</p></article>
                    <article data-agenda-page="1" class="rounded-2xl border border-green-200 bg-white p-6 shadow-sm"><div class="mb-5 flex items-start justify-between gap-4"><span class="rounded-full bg-green-50 px-3 py-1 text-sm font-bold text-green-700">TODO OCT</span><svg class="h-7 w-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 3a9 9 0 100 18 9 9 0 000-18zm0 4v5l3 2"/></svg></div><p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Seguridad familiar</p><h3 class="mb-2 text-2xl font-bold">Mes de la ciberseguridad</h3><p class="mb-4 text-gray-700">Guías para niñas, niños, adolescentes y personas cuidadoras.</p><a href="/guias/guia-familiar-ciberseguridad.html" class="font-bold text-green-700 hover:text-green-900">Consultar las guías <span aria-hidden="true">→</span></a></article>
                    <article data-agenda-page="1" class="rounded-2xl border border-blue-200 bg-white p-6 shadow-sm"><div class="mb-5 flex items-start justify-between gap-4"><span class="rounded-full bg-blue-50 px-3 py-1 text-sm font-bold text-blue-700">14 OCT</span><svg class="h-7 w-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 19h16M6 17V5h12v12M9 9h6M9 13h4"/></svg></div><p class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Ingeniería</p><h3 class="mb-2 text-2xl font-bold">Día Mundial de la Normalización</h3><p class="text-gray-700">Una mirada sencilla a estándares, interoperabilidad y calidad de software.</p></article>
                    <article data-agenda-page="2" class="hidden rounded-2xl border border-orange-200 bg-white p-6 shadow-sm"><span class="rounded-full bg-orange-50 px-3 py-1 text-sm font-bold text-orange-700">1–2 NOV</span><p class="mt-5 mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Cultura de México</p><h3 class="mb-2 text-2xl font-bold">Día de Muertos</h3><p class="text-gray-700">Una pieza respetuosa sobre memoria, identidad y comunidad.</p></article>
                    <article data-agenda-page="2" class="hidden rounded-2xl border border-blue-200 bg-white p-6 shadow-sm"><span class="rounded-full bg-blue-50 px-3 py-1 text-sm font-bold text-blue-700">12 NOV</span><p class="mt-5 mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Tecnología</p><h3 class="mb-2 text-2xl font-bold">Día Mundial de la Usabilidad</h3><p class="text-gray-700">Consejos para crear experiencias digitales útiles, claras y accesibles.</p></article>
                    <article data-agenda-page="2" class="hidden rounded-2xl border border-green-200 bg-white p-6 shadow-sm"><span class="rounded-full bg-green-50 px-3 py-1 text-sm font-bold text-green-700">20 NOV</span><p class="mt-5 mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Identidad de México</p><h3 class="mb-2 text-2xl font-bold">Revolución Mexicana</h3><p class="text-gray-700">Un mensaje histórico breve e institucional sobre transformación y comunidad.</p></article>
                    <article data-agenda-page="2" class="hidden rounded-2xl border border-green-200 bg-white p-6 shadow-sm"><span class="rounded-full bg-green-50 px-3 py-1 text-sm font-bold text-green-700">30 NOV</span><p class="mt-5 mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Seguridad</p><h3 class="mb-2 text-2xl font-bold">Día de la Seguridad Informática</h3><p class="text-gray-700">Cerramos el ciclo con hábitos, aprendizajes y compromisos.</p></article>
                </div>
                <div class="mt-8 flex items-center justify-center gap-3"><button id="agenda-prev" type="button" class="rounded-xl border border-gray-300 bg-white px-4 py-2 font-bold text-gray-700 disabled:cursor-not-allowed disabled:opacity-40" disabled>Anterior</button><button id="agenda-next" type="button" class="rounded-xl bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700">Siguiente</button></div>
            </div>
        </dialog>

        <!-- CAMPAÑA COMUNITARIA ACTIVA -->
        <section id="comunidad" class="relative overflow-hidden bg-slate-950 px-4 py-20 text-white sm:px-6 lg:px-8 lg:py-24">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_85%_20%,rgba(37,99,235,0.28),transparent_34%),linear-gradient(105deg,rgba(16,185,129,0.14),transparent_42%,rgba(239,68,68,0.1))]" aria-hidden="true"></div>
            <div class="relative z-10 mx-auto max-w-6xl">
                <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
                    <div>
                        <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-green-300">Septiembre · Orgullosamente construimos desde México</p>
                        <h2 class="mb-5 text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">Tecnología con identidad y propósito</h2>
                        <p class="mb-8 text-lg leading-relaxed text-blue-100 sm:text-xl">Este mes reconocemos el talento, la creatividad y la responsabilidad de quienes convierten problemas en soluciones desde México.</p>
                        <div class="mb-7 flex items-start gap-4 rounded-2xl border border-white/15 bg-white/10 p-5">
                            <svg class="mt-1 h-7 w-7 flex-shrink-0 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M8 3v4m8-4v4M5 9h14M6 5h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2zm3 6h6m-6 4h4"/></svg>
                            <div><p class="mb-1 text-sm font-bold uppercase tracking-[0.14em] text-green-300">Primera actividad · 13 de septiembre</p><h3 class="mb-2 text-2xl font-black text-white">Día del Programador</h3><p class="text-blue-100">Una pausa para reconocer a quienes imaginan, diseñan y construyen soluciones que hacen avanzar a sus comunidades.</p></div>
                        </div>
                    </div>
                    <div class="overflow-hidden rounded-3xl border border-white/20 bg-white/10 shadow-2xl">
                        <img src="/Dia-del-programador.jpg" alt="Core celebra el Día del Programador el 13 de septiembre" class="h-full w-full object-cover" loading="eager" />
                    </div>
                </div>
                <div class="mt-7 flex justify-center lg:justify-end">
                    <button type="button" data-agenda-open class="inline-flex items-center gap-2 rounded-xl bg-green-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-green-300">Ver agenda <span aria-hidden="true">→</span></button>
                </div>
            </div>
        </section>

        <!-- NUESTRA VISIÓN -->
        <section id="vision" class="py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-white">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6">Nuestra Visión</h2>
                    <p class="text-xl text-gray-700 max-w-3xl mx-auto">
                        De construir una aplicación a construir una base de ingeniería y un ecosistema completo
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="p-8 bg-gradient-to-br from-green-50 to-green-100/50 rounded-2xl border border-green-200">
                        <div class="text-4xl mb-4">1️⃣</div>
                        <h3 class="text-2xl font-bold mb-3">Idea</h3>
                        <p class="text-gray-700">Identificamos la necesidad real de nuestros clientes</p>
                    </div>
                    <div class="p-8 bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-2xl border border-blue-200">
                        <div class="text-4xl mb-4">2️⃣</div>
                        <h3 class="text-2xl font-bold mb-3">TrimmOS Monolítico</h3>
                        <p class="text-gray-700">Primer producto que nos enseñó a construir para escalar</p>
                    </div>
                    <div class="p-8 bg-gradient-to-br from-orange-50 to-orange-100/50 rounded-2xl border border-orange-200">
                        <div class="text-4xl mb-4">3️⃣</div>
                        <h3 class="text-2xl font-bold mb-3">Aprendizaje</h3>
                        <p class="text-gray-700">Reconocimos la necesidad de separar responsabilidades</p>
                    </div>
                </div>

                <div class="mt-12 p-8 bg-gradient-to-r from-green-50/30 via-blue-50/30 to-orange-50/30 rounded-3xl border border-gray-200">
                    <h3 class="text-3xl font-bold mb-6 text-center">Resultado de la Evolución</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Hesed Core Platform</h4>
                                <p class="text-gray-700">Núcleo tecnológico común con capacidades compartidas</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v2h8v-2zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-2a4 4 0 00-8 0v2h8z" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Productos Independientes</h4>
                                <p class="text-gray-700">TrimmOS, FactuCore, E-ComerCore y futuros productos</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-orange-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10.5 1.5H5.75A2.25 2.25 0 003.5 3.75v12.5A2.25 2.25 0 005.75 18.5h8.5a2.25 2.25 0 002.25-2.25V6.5m-11-5v5h5m-5-5L15.5 13.5" stroke="currentColor" stroke-width="1.5" fill="none" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Hesed Customer Platform</h4>
                                <p class="text-gray-700">Experiencia central para clientes y usuarios finales</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-green-700 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Ecosistema Completo</h4>
                                <p class="text-gray-700">Plataforma escalable y sostenible para el futuro</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CORE - NUESTRO PROPÓSITO -->
        <section id="core" class="py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-white">
            <div class="max-w-6xl mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                    <div class="flex justify-center">
                        <div class="w-full max-w-sm core-cloud">
                            <img src="/Core.png" alt="Core - Mascota de Hesed Core flotando sobre una nube" loading="lazy" class="relative z-10 w-full h-auto drop-shadow-2xl" />
                        </div>
                    </div>
                    <div>
                        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6">Conoce a <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-700">Core</span></h2>
                        <p class="text-xl text-gray-700 mb-6 leading-relaxed">
                            Core es la representación del propósito que impulsa cada decisión en Hesed Core. Es la chispa que transforma ideas complejas en soluciones simples, escalables y con impacto real.
                        </p>
                        
                        <div class="space-y-4 mb-8">
                            <div class="flex items-start gap-4">
                                <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
