        <script>
            const agendaDialog = document.getElementById('agenda') as HTMLDialogElement | null;
            const agendaOpenButtons = document.querySelectorAll<HTMLButtonElement>('[data-agenda-open]');
            const agendaClose = document.getElementById('agenda-close');
            const agendaItems = document.querySelectorAll<HTMLElement>('[data-agenda-page]');
            const agendaStatus = document.getElementById('agenda-status');
            const agendaPrevious = document.getElementById('agenda-prev') as HTMLButtonElement | null;
            const agendaNext = document.getElementById('agenda-next') as HTMLButtonElement | null;
            let agendaPage = 1;

            agendaOpenButtons.forEach(button => {
                button.addEventListener('click', () => agendaDialog?.showModal());
            });

            agendaClose?.addEventListener('click', () => agendaDialog?.close());
            agendaDialog?.addEventListener('click', event => {
                if (event.target === agendaDialog) agendaDialog.close();
            });

            function updateAgenda() {
                agendaItems.forEach(item => {
                    item.classList.toggle('hidden', item.dataset.agendaPage !== String(agendaPage));
                });
                if (agendaStatus) agendaStatus.textContent = `Página ${agendaPage} de 2`;
                if (agendaPrevious) agendaPrevious.disabled = agendaPage === 1;
                if (agendaNext) agendaNext.disabled = agendaPage === 2;
            }

            agendaPrevious?.addEventListener('click', () => {
                agendaPage = Math.max(1, agendaPage - 1);
                updateAgenda();
            });

            agendaNext?.addEventListener('click', () => {
                agendaPage = Math.min(2, agendaPage + 1);
                updateAgenda();
            });

            // Scroll Animations - Esperar a que el DOM esté completamente listo
            document.addEventListener('DOMContentLoaded', function() {
                const observerOptions = {
                    threshold: 0.1,
                    rootMargin: '0px 0px -50px 0px'
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('active');
                            observer.unobserve(entry.target);
                        }
                    });
                }, observerOptions);

                // Apply animations to sections
                const sections = document.querySelectorAll('section');
                sections.forEach(section => {
                    section.classList.add('fade-in');
                    observer.observe(section);
                });

                // Apply animations to specific card elements
                const cards = document.querySelectorAll('.product-card, .founder-card, .team-member');
                cards.forEach((card, index) => {
                    card.classList.add('slide-up');
                    card.classList.add(`stagger-${(index % 4) + 1}`);
                    observer.observe(card);
                });
            });
        </script>
