---
import Navbar from '../components/navbar.astro';
import '../styles/global.css';
---

<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/Hesed-Core-logo.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Hesed Core | Ingeniería de Software con Propósito</title>
        <meta name="description" content="Hesed Core diseña y construye plataformas y productos digitales preparados para evolucionar, crecer y proteger la información que sus clientes confían." />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <style>
            body { font-family: 'Inter', sans-serif; }
            .hero-gradient {
                background: linear-gradient(135deg, 
                    rgba(16, 185, 129, 0.08) 0%, 
                    rgba(59, 130, 246, 0.08) 50%, 
                    rgba(245, 158, 11, 0.04) 100%);
            }
            .floating-shapes {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                overflow: hidden;
                z-index: 0;
            }
            .product-card {
                min-height: 430px;
            }
            .platform-visual {
                background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(248,250,252,1) 100%);
            }
            .shape {
                position: absolute;
                border-radius: 50%;
                background: linear-gradient(45deg, rgba(16, 185, 129, 0.08), rgba(59, 130, 246, 0.08));
                animation: float 6s ease-in-out infinite;
            }
            .shape:nth-child(1) {
                width: 80px;
                height: 80px;
                top: 10%;
                left: 10%;
                animation-delay: 0s;
            }
            .shape:nth-child(2) {
                width: 60px;
                height: 60px;
                top: 20%;
                right: 15%;
                animation-delay: 2s;
            }
            .shape:nth-child(3) {
                width: 100px;
                height: 100px;
                bottom: 20%;
                left: 20%;
                animation-delay: 4s;
            }
            @keyframes float {
                0%, 100% { transform: translateY(0px) rotate(0deg); }
                50% { transform: translateY(-20px) rotate(180deg); }
            }
        </style>
    </head>
    <body class="bg-white text-gray-900 hero-gradient min-h-screen">
        <Navbar />

        <!-- HERO SECTION - "Ingeniería de Software con Propósito" -->
        <section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
            <div class="floating-shapes">
                <div class="shape"></div>
                <div class="shape"></div>
                <div class="shape"></div>
            </div>
            
            <div class="max-w-6xl mx-auto w-full text-center relative z-10">
                <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight mb-8 leading-tight">
                    Ingeniería de Software
                    <br class="hidden sm:block"><span class="text-transparent bg-clip-text bg-gradient-to-r from-green-600 via-blue-600 to-green-600">con Propósito</span>
                </h1>
                
                <p class="text-lg sm:text-xl md:text-2xl text-gray-700 max-w-4xl mx-auto mb-12 leading-relaxed px-4">
                    Hesed Core diseña y construye plataformas y productos digitales preparados para 
                    <strong class="text-gray-900">evolucionar, crecer y proteger</strong> la información que tus clientes confían.
                </p>
                
                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-4 sm:gap-6 mt-12">
                    <a href="#platform" class="group bg-gradient-to-r from-green-600 to-green-700 text-white px-8 py-4 rounded-2xl font-bold text-lg shadow-lg hover:shadow-green-600/40 hover-lift transition-all duration-300">
                        <span class="flex items-center justify-center gap-2">
                            Conocer Hesed Core Platform
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                            </svg>
                        </span>
                    </a>
                    
                    <a href="#productos" class="group bg-white border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-2xl font-bold text-lg hover:border-blue-500 hover:text-blue-600 transition-all duration-300 hover-lift">
                        <span class="flex items-center justify-center gap-2">
                            Explorar Productos
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </span>
                    </a>
                </div>
            </div>
        </section>

        <!-- NUESTRA VISIÓN -->
        <section id="vision" class="py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-white">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6">Nuestra Visión</h2>
                    <p class="text-xl text-gray-700 max-w-3xl mx-auto">
                        De construir una aplicación a construir una base de ingeniería y un ecosistema completo
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="p-8 bg-gradient-to-br from-green-50 to-green-100/50 rounded-2xl border border-green-200">
                        <div class="text-4xl mb-4">1️⃣</div>
                        <h3 class="text-2xl font-bold mb-3">Idea</h3>
                        <p class="text-gray-700">Identificamos la necesidad real de nuestros clientes</p>
                    </div>
                    <div class="p-8 bg-gradient-to-br from-blue-50 to-blue-100/50 rounded-2xl border border-blue-200">
                        <div class="text-4xl mb-4">2️⃣</div>
                        <h3 class="text-2xl font-bold mb-3">TrimmOS Monolítico</h3>
                        <p class="text-gray-700">Primer producto que nos enseñó a construir para escalar</p>
                    </div>
                    <div class="p-8 bg-gradient-to-br from-orange-50 to-orange-100/50 rounded-2xl border border-orange-200">
                        <div class="text-4xl mb-4">3️⃣</div>
                        <h3 class="text-2xl font-bold mb-3">Aprendizaje</h3>
                        <p class="text-gray-700">Reconocimos la necesidad de separar responsabilidades</p>
                    </div>
                </div>

                <div class="mt-12 p-8 bg-gradient-to-r from-green-50/30 via-blue-50/30 to-orange-50/30 rounded-3xl border border-gray-200">
                    <h3 class="text-3xl font-bold mb-6 text-center">Resultado de la Evolución</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Hesed Core Platform</h4>
                                <p class="text-gray-700">Núcleo tecnológico común con capacidades compartidas</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v2h8v-2zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-2a4 4 0 00-8 0v2h8z" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Productos Independientes</h4>
                                <p class="text-gray-700">TrimmOS, FactuCore, E-ComerCore y futuros productos</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-orange-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10.5 1.5H5.75A2.25 2.25 0 003.5 3.75v12.5A2.25 2.25 0 005.75 18.5h8.5a2.25 2.25 0 002.25-2.25V6.5m-11-5v5h5m-5-5L15.5 13.5" stroke="currentColor" stroke-width="1.5" fill="none" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Hesed Customer Platform</h4>
                                <p class="text-gray-700">Experiencia central para clientes y usuarios finales</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <svg class="w-6 h-6 text-green-700 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                            <div>
                                <h4 class="font-bold text-lg mb-1">Ecosistema Completo</h4>
                                <p class="text-gray-700">Plataforma escalable y sostenible para el futuro</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CORE - NUESTRO PROPÓSITO -->
        <section id="core" class="py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-white">
            <div class="max-w-6xl mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                    <div class="flex justify-center">
                        <div class="w-full max-w-sm">
                            <img src="/Core.png" alt="Core - Mascota de Hesed Core" loading="lazy" class="w-full h-auto drop-shadow-2xl slide-up" />
                        </div>
                    </div>
                    <div>
                        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6">Conoce a <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-blue-700">Core</span></h2>
                        <p class="text-xl text-gray-700 mb-6 leading-relaxed">
                            Core es la representación del propósito que impulsa cada decisión en Hesed Core. Es la chispa que transforma ideas complejas en soluciones simples, escalables y con impacto real.
                        </p>
                        
                        <div class="space-y-4 mb-8">
                            <div class="flex items-start gap-4">
                                <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <div>
                                    <h3 class="font-bold text-lg text-gray-900">Propósito</h3>
                                    <p class="text-gray-700">Guía cada línea de código y cada decisión arquitectónica</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <div>
                                    <h3 class="font-bold text-lg text-gray-900">Ingeniería</h3>
                                    <p class="text-gray-700">Soluciones técnicas robustas y escalables para el futuro</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <div>
                                    <h3 class="font-bold text-lg text-gray-900">Innovación</h3>
                                    <p class="text-gray-700">Constantemente explorando nuevas posibilidades y mejores caminos</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <svg class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <div>
                                    <h3 class="font-bold text-lg text-gray-900">Cercanía</h3>
                                    <p class="text-gray-700">Conectados con nuestros clientes y sus necesidades reales</p>
                                </div>
                            </div>
                        </div>

                        <p class="text-lg text-gray-700 italic border-l-4 border-blue-600 pl-4">
                            "La chispa en el corazón de Hesed Core que transforma software en soluciones que importan"
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- HESED CORE PLATFORM -->
        <section id="platform" class="py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gray-50">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6">Hesed Core Platform</h2>
                    <p class="text-xl text-gray-700 max-w-3xl mx-auto">
                        El núcleo tecnológico común que potencia nuestro ecosistema
                    </p>
                </div>

                <div class="flex justify-center mb-10">
                    <div class="w-full max-w-3xl platform-visual rounded-3xl border border-gray-200 shadow-xl p-3">
                        <img src="/hesed-core-plataform.png" alt="Hesed Core Platform" loading="lazy" class="w-full h-auto max-h-[420px] object-contain rounded-2xl mx-auto" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="p-8 bg-white rounded-2xl border border-gray-200 shadow-md hover-lift">
                        <svg class="w-8 h-8 text-green-600 mb-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                        <h3 class="text-xl font-bold mb-3">Identity & Autenticación</h3>
                        <p class="text-gray-700">Gestión centralizada de identidad y autenticación segura</p>
                    </div>
                    <div class="p-8 bg-white rounded-2xl border border-gray-200 shadow-md hover-lift">
                        <svg class="w-8 h-8 text-blue-600 mb-4" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M3.289 10.002L9.646 2.56c.42-.348 1.132-.348 1.553 0l6.356 7.443m-8.9 3.486l5.35 6.28c.42.348 1.13.348 1.55 0l5.35-6.28" stroke="currentColor" stroke-width="1.5" fill="none" />
                        </svg>
                        <h3 class="text-xl font-bold mb-3">Autorización & MFA</h3>
                        <p class="text-gray-700">Control granular de permisos y autenticación multifactor</p>
                    </div>
                    <div class="p-8 bg-white rounded-2xl border border-gray-200 shadow-md hover-lift">
                        <svg class="w-8 h-8 text-orange-600 mb-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.293 7.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 5.414V15a1 1 0 11-2 0V5.414L6.707 7.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                        <h3 class="text-xl font-bold mb-3">Seguridad & Policies</h3>
                        <p class="text-gray-700">Políticas automatizadas y controles de seguridad avanzados</p>
                    </div>
                    <div class="p-8 bg-white rounded-2xl border border-gray-200 shadow-md hover-lift">
                        <svg class="w-8 h-8 text-green-700 mb-4" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" />
                        </svg>
                        <h3 class="text-xl font-bold mb-3">Observabilidad</h3>
                        <p class="text-gray-700">Monitoreo completo y análisis en tiempo real</p>
                    </div>
                    <div class="p-8 bg-white rounded-2xl border border-gray-200 shadow-md hover-lift">
                        <svg class="w-8 h-8 text-blue-700 mb-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v2h16V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a2 2 0 012-2h8a2 2 0 012 2v9a2 2 0 01-2 2H8a2 2 0 01-2-2V7z" clip-rule="evenodd" />
                        </svg>
                        <h3 class="text-xl font-bold mb-3">Auditoría</h3>
                        <p class="text-gray-700">Trazabilidad completa y logs detallados de todas las acciones</p>
                    </div>
                    <div class="p-8 bg-white rounded-2xl border border-gray-200 shadow-md hover-lift">
                        <svg class="w-8 h-8 text-orange-700 mb-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 17v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd" />
                        </svg>
                        <h3 class="text-xl font-bold mb-3">Servicios Compartidos</h3>
                        <p class="text-gray-700">APIs y servicios comunes para todos los productos</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRODUCTOS HESED CORE -->
        <section id="productos" class="py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-white">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6">Productos Hesed Core</h2>
                    <p class="text-xl text-gray-700 max-w-3xl mx-auto">
                        Soluciones independientes construidas sobre nuestra plataforma común
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- TrimmOS -->
                    <a href="https://www.trimmos.com/" target="_blank" rel="noopener noreferrer" class="group product-card bg-white border-2 border-green-300 rounded-3xl p-8 shadow-lg hover-lift hover:border-green-500 transition-all cursor-pointer block">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-md flex-shrink-0">
                                <img src="/logo.png" alt="TrimmOS" class="w-14 h-14 object-contain" />
                            </div>
                            <div>
                                <h3 class="text-3xl font-black text-gray-900">TrimmOS</h3>
                                <p class="text-green-700 font-semibold text-sm uppercase">Sistema de Gestión</p>
                            </div>
                        </div>
                        <p class="text-gray-700 mb-6 text-lg leading-relaxed">
                            Gestión completa para barberías y salones. Agenda automática, personal, servicios, clientes y reportes inteligentes descargables en PDF/Excel.
                        </p>
                        <ul class="space-y-3 mb-8">
                            <li class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                <span class="text-gray-700">Agenda automática con códigos QR</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                <span class="text-gray-700">Gestión de clientes y empleados</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                <span class="text-gray-700">Reportes detallados PDF/Excel</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                <span class="text-gray-700">Personalización de marca</span>
